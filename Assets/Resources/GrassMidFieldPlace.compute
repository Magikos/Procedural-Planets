#pragma kernel PlaceAndCullMidField

struct BiomeGrassParams
{
    float4 Shape;
    float4 Placement;
    float4 Tint;
};

struct GrassCardInstance
{
    float4 RootHeight;
    float4 UpWidth;
    float4 Color;
};

Texture2D<float4> _MidFieldBiomeIds_F0;
Texture2D<float4> _MidFieldBiomeIds_F1;
Texture2D<float4> _MidFieldBiomeIds_F2;
Texture2D<float4> _MidFieldBiomeIds_F3;
Texture2D<float4> _MidFieldBiomeIds_F4;
Texture2D<float4> _MidFieldBiomeIds_F5;
Texture2D<float4> _MidFieldBiomeWeights_F0;
Texture2D<float4> _MidFieldBiomeWeights_F1;
Texture2D<float4> _MidFieldBiomeWeights_F2;
Texture2D<float4> _MidFieldBiomeWeights_F3;
Texture2D<float4> _MidFieldBiomeWeights_F4;
Texture2D<float4> _MidFieldBiomeWeights_F5;
Texture2D<float> _MidFieldSurfaceRadius_F0;
Texture2D<float> _MidFieldSurfaceRadius_F1;
Texture2D<float> _MidFieldSurfaceRadius_F2;
Texture2D<float> _MidFieldSurfaceRadius_F3;
Texture2D<float> _MidFieldSurfaceRadius_F4;
Texture2D<float> _MidFieldSurfaceRadius_F5;
Texture2D<float4> _MidFieldSurfaceNormal_F0;
Texture2D<float4> _MidFieldSurfaceNormal_F1;
Texture2D<float4> _MidFieldSurfaceNormal_F2;
Texture2D<float4> _MidFieldSurfaceNormal_F3;
Texture2D<float4> _MidFieldSurfaceNormal_F4;
Texture2D<float4> _MidFieldSurfaceNormal_F5;

StructuredBuffer<BiomeGrassParams> _MidFieldBiomeGrassParams;
RWStructuredBuffer<GrassCardInstance> _MidFieldGrassInstances;
RWStructuredBuffer<uint> _MidFieldDrawArgs;
RWStructuredBuffer<uint> _MidFieldStats;

#define MID_STAT_CANDIDATE 0
#define MID_STAT_DENSITY_REJECTED 1
#define MID_STAT_WATER_REJECTED 2
#define MID_STAT_SLOPE_REJECTED 3
#define MID_STAT_DISTANCE_REJECTED 4
#define MID_STAT_DISTANCE_FADE_REJECTED 5
#define MID_STAT_FACE_AREA_REJECTED 6
#define MID_STAT_EMITTED 7
#define MID_STAT_OVERFLOW 8

int _MidFieldBiomeAtlasResolution;
int _MidFieldSurfaceAtlasResolution;
int _MidFieldBiomeParamCount;
int _MidFieldCapacity;
int _MidFieldSeed;
int _MidFieldFaceIndex;
int2 _MidFieldGridStartCellUV;
int2 _MidFieldGridSize;
float _MidFieldCellUvWidth;
float _MidFieldSpacing;
float _MidFieldFullDensityDistance;
float _MidFieldDrawDistance;
float _MidFieldInnerFadeStart;
float _MidFieldInnerFadeEnd;
float _MidFieldOuterFadeBand;
float _MidFieldWaterRadius;
float _MidFieldPlanetWorldScale;
float4x4 _MidFieldPlanetLocalToWorld;
float3 _MidFieldPlanetCenterWs;
float3 _MidFieldCameraPositionWs;

void AddStat(uint index)
{
    InterlockedAdd(_MidFieldStats[index], 1u);
}

uint HashUint(uint x)
{
    x ^= x >> 16;
    x *= 0x7feb352du;
    x ^= x >> 15;
    x *= 0x846ca68bu;
    x ^= x >> 16;
    return x;
}

float Hash01(uint seed)
{
    return (HashUint(seed) & 0x00ffffffu) / 16777216.0;
}

float3 CubeFaceToUnitSphere(int face, float2 uv)
{
    float u = uv.x * 2.0 - 1.0;
    float v = uv.y * 2.0 - 1.0;
    float3 p;
    if (face == 0) p = float3(u, 1.0, -v);
    else if (face == 1) p = float3(-u, -1.0, -v);
    else if (face == 2) p = float3(-1.0, -v, -u);
    else if (face == 3) p = float3(1.0, -v, u);
    else if (face == 4) p = float3(-v, u, 1.0);
    else p = float3(-v, -u, -1.0);
    return normalize(p);
}

float CubeFaceAreaKeep(float2 uv)
{
    float2 signedUv = uv * 2.0 - 1.0;
    float denom = max(1.0 + dot(signedUv, signedUv), 1e-6);
    return saturate(rsqrt(denom * denom * denom));
}

float4 LoadBiomeIds(int face, int2 p)
{
    float4 value = 0.0;
    if (face == 0) value = _MidFieldBiomeIds_F0.Load(int3(p, 0));
    else if (face == 1) value = _MidFieldBiomeIds_F1.Load(int3(p, 0));
    else if (face == 2) value = _MidFieldBiomeIds_F2.Load(int3(p, 0));
    else if (face == 3) value = _MidFieldBiomeIds_F3.Load(int3(p, 0));
    else if (face == 4) value = _MidFieldBiomeIds_F4.Load(int3(p, 0));
    else value = _MidFieldBiomeIds_F5.Load(int3(p, 0));
    return value;
}

float4 LoadBiomeWeights(int face, int2 p)
{
    float4 value = 0.0;
    if (face == 0) value = _MidFieldBiomeWeights_F0.Load(int3(p, 0));
    else if (face == 1) value = _MidFieldBiomeWeights_F1.Load(int3(p, 0));
    else if (face == 2) value = _MidFieldBiomeWeights_F2.Load(int3(p, 0));
    else if (face == 3) value = _MidFieldBiomeWeights_F3.Load(int3(p, 0));
    else if (face == 4) value = _MidFieldBiomeWeights_F4.Load(int3(p, 0));
    else value = _MidFieldBiomeWeights_F5.Load(int3(p, 0));
    return value;
}

float LoadRadius(int face, int2 p)
{
    float value = 0.0;
    if (face == 0) value = _MidFieldSurfaceRadius_F0.Load(int3(p, 0));
    else if (face == 1) value = _MidFieldSurfaceRadius_F1.Load(int3(p, 0));
    else if (face == 2) value = _MidFieldSurfaceRadius_F2.Load(int3(p, 0));
    else if (face == 3) value = _MidFieldSurfaceRadius_F3.Load(int3(p, 0));
    else if (face == 4) value = _MidFieldSurfaceRadius_F4.Load(int3(p, 0));
    else value = _MidFieldSurfaceRadius_F5.Load(int3(p, 0));
    return value;
}

float4 LoadNormal(int face, int2 p)
{
    float4 value = float4(0.5, 0.5, 1.0, 1.0);
    if (face == 0) value = _MidFieldSurfaceNormal_F0.Load(int3(p, 0));
    else if (face == 1) value = _MidFieldSurfaceNormal_F1.Load(int3(p, 0));
    else if (face == 2) value = _MidFieldSurfaceNormal_F2.Load(int3(p, 0));
    else if (face == 3) value = _MidFieldSurfaceNormal_F3.Load(int3(p, 0));
    else if (face == 4) value = _MidFieldSurfaceNormal_F4.Load(int3(p, 0));
    else value = _MidFieldSurfaceNormal_F5.Load(int3(p, 0));
    return value;
}

float SampleSurfaceRadius(int face, float2 uv)
{
    int resolution = max(_MidFieldSurfaceAtlasResolution, 1);
    float2 p = saturate(uv) * max(resolution - 1, 1);
    int2 p0 = int2(floor(p));
    int2 p1 = min(p0 + 1, int2(resolution - 1, resolution - 1));
    float2 f = p - p0;
    float r00 = LoadRadius(face, p0);
    float r10 = LoadRadius(face, int2(p1.x, p0.y));
    float r01 = LoadRadius(face, int2(p0.x, p1.y));
    float r11 = LoadRadius(face, p1);
    return lerp(lerp(r00, r10, f.x), lerp(r01, r11, f.x), f.y);
}

float3 SampleSurfaceNormal(int face, float2 uv)
{
    int resolution = max(_MidFieldSurfaceAtlasResolution, 1);
    int2 p = clamp(int2(round(saturate(uv) * max(resolution - 1, 1))),
        int2(0, 0), int2(resolution - 1, resolution - 1));
    return normalize(LoadNormal(face, p).xyz * 2.0 - 1.0);
}

BiomeGrassParams GetGrassParams(uint id)
{
    BiomeGrassParams p;
    p.Shape = 0.0;
    p.Placement = 0.0;
    p.Tint = 0.0;
    if (id < (uint)_MidFieldBiomeParamCount)
        p = _MidFieldBiomeGrassParams[id];
    return p;
}

BiomeGrassParams BlendGrassParams(float4 ids, float4 weights, out float density)
{
    BiomeGrassParams blended;
    blended.Shape = 0.0;
    blended.Placement = 0.0;
    blended.Tint = 0.0;
    density = 0.0;
    float total = 0.0;

    [unroll]
    for (uint i = 0; i < 4; i++)
    {
        float weight = saturate(weights[i]);
        if (weight <= 0.0001)
            continue;
        BiomeGrassParams p = GetGrassParams((uint)round(ids[i] * 255.0));
        float grassDensity = saturate(p.Shape.x);
        density += grassDensity * pow(weight, max(p.Placement.w, 0.001));
        float paramWeight = weight * grassDensity;
        blended.Shape.yzw += p.Shape.yzw * paramWeight;
        blended.Placement += p.Placement * paramWeight;
        blended.Tint.rgb += p.Tint.rgb * paramWeight;
        total += paramWeight;
    }

    density = saturate(density);
    blended.Shape.x = density;
    blended.Tint.a = 1.0;
    if (total > 0.0001)
    {
        float inv = rcp(total);
        blended.Shape.yzw *= inv;
        blended.Placement *= inv;
        blended.Tint.rgb *= inv;
    }
    return blended;
}

BiomeGrassParams LerpGrassParams(BiomeGrassParams a, BiomeGrassParams b, float t)
{
    BiomeGrassParams p;
    p.Shape = lerp(a.Shape, b.Shape, t);
    p.Placement = lerp(a.Placement, b.Placement, t);
    p.Tint = lerp(a.Tint, b.Tint, t);
    return p;
}

BiomeGrassParams SampleGrassParams(int face, float2 uv, out float density)
{
    int resolution = max(_MidFieldBiomeAtlasResolution, 1);
    int maxTexel = max(0, resolution - 1);
    float2 coord = saturate(uv) * resolution - 0.5;
    int2 baseTexel = int2(floor(coord));
    float2 f = saturate(coord - baseTexel);
    int2 t00 = clamp(baseTexel, int2(0, 0), int2(maxTexel, maxTexel));
    int2 t10 = clamp(baseTexel + int2(1, 0), int2(0, 0), int2(maxTexel, maxTexel));
    int2 t01 = clamp(baseTexel + int2(0, 1), int2(0, 0), int2(maxTexel, maxTexel));
    int2 t11 = clamp(baseTexel + int2(1, 1), int2(0, 0), int2(maxTexel, maxTexel));

    float d00, d10, d01, d11;
    BiomeGrassParams p00 = BlendGrassParams(LoadBiomeIds(face, t00), LoadBiomeWeights(face, t00), d00);
    BiomeGrassParams p10 = BlendGrassParams(LoadBiomeIds(face, t10), LoadBiomeWeights(face, t10), d10);
    BiomeGrassParams p01 = BlendGrassParams(LoadBiomeIds(face, t01), LoadBiomeWeights(face, t01), d01);
    BiomeGrassParams p11 = BlendGrassParams(LoadBiomeIds(face, t11), LoadBiomeWeights(face, t11), d11);
    BiomeGrassParams p = LerpGrassParams(
        LerpGrassParams(p00, p10, f.x),
        LerpGrassParams(p01, p11, f.x), f.y);
    density = saturate(p.Shape.x);
    p.Shape.x = density;
    return p;
}

[numthreads(8, 8, 1)]
void PlaceAndCullMidField(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _MidFieldGridSize.x || (int)id.y >= _MidFieldGridSize.y)
        return;

    AddStat(MID_STAT_CANDIDATE);
    int2 cell = _MidFieldGridStartCellUV + int2(id.xy);
    uint cellHash = HashUint((uint)_MidFieldSeed
        ^ ((uint)_MidFieldFaceIndex * 0x9e3779b9u)
        ^ ((uint)cell.x * 73856093u)
        ^ ((uint)cell.y * 19349663u));
    float2 jitter = float2(
        Hash01(cellHash ^ 0xa341316cu) - 0.5,
        Hash01(cellHash ^ 0x6a09e667u) - 0.5);
    float2 faceUv = (float2(cell) + 0.5 + jitter) * _MidFieldCellUvWidth;
    if (any(faceUv < 0.0) || any(faceUv > 1.0))
    {
        AddStat(MID_STAT_DISTANCE_REJECTED);
        return;
    }

    if (Hash01(cellHash ^ 0x2c1b3c6du) > CubeFaceAreaKeep(faceUv))
    {
        AddStat(MID_STAT_FACE_AREA_REJECTED);
        return;
    }

    float3 sphereDirection = CubeFaceToUnitSphere(_MidFieldFaceIndex, faceUv);
    float surfaceRadius = SampleSurfaceRadius(_MidFieldFaceIndex, faceUv);
    float3 localRoot = sphereDirection * surfaceRadius;
    float3 rootWs = mul(_MidFieldPlanetLocalToWorld, float4(localRoot, 1.0)).xyz;
    float distanceFromCamera = length(rootWs - _MidFieldCameraPositionWs);
    if (distanceFromCamera > _MidFieldDrawDistance)
    {
        AddStat(MID_STAT_DISTANCE_REJECTED);
        return;
    }

    float distanceT = saturate((distanceFromCamera - _MidFieldFullDensityDistance)
        / max(_MidFieldDrawDistance - _MidFieldFullDensityDistance, 0.001));
    float distanceKeep = lerp(1.0, 0.58, smoothstep(0.0, 1.0, distanceT));
    if (Hash01(cellHash ^ 0x1f83d9abu) > distanceKeep)
    {
        AddStat(MID_STAT_DISTANCE_FADE_REJECTED);
        return;
    }

    float density;
    BiomeGrassParams biome = SampleGrassParams(_MidFieldFaceIndex, faceUv, density);
    if (density <= 0.001 || biome.Shape.y <= 0.0)
    {
        AddStat(MID_STAT_DENSITY_REJECTED);
        return;
    }

    if (_MidFieldWaterRadius > 0.0
        && surfaceRadius <= _MidFieldWaterRadius + max(biome.Placement.z, 0.0))
    {
        AddStat(MID_STAT_WATER_REJECTED);
        return;
    }

    float3 normalLocal = SampleSurfaceNormal(_MidFieldFaceIndex, faceUv);
    if (dot(normalLocal, sphereDirection) < 0.0)
        normalLocal = -normalLocal;
    float slopeDegrees = acos(saturate(dot(normalLocal, sphereDirection))) * 57.2957795;
    float maxSlope = clamp(biome.Placement.x, 0.0, 90.0);
    float slopeFade = max(biome.Placement.y, 0.001);
    float slopeKeep = 1.0 - smoothstep(maxSlope - slopeFade, maxSlope + slopeFade, slopeDegrees);
    if (Hash01(cellHash ^ 0xa54ff53au) > slopeKeep)
    {
        AddStat(MID_STAT_SLOPE_REJECTED);
        return;
    }

    if (Hash01(cellHash ^ 0x3c6ef372u) > density)
    {
        AddStat(MID_STAT_DENSITY_REJECTED);
        return;
    }

    float innerFade = smoothstep(_MidFieldInnerFadeStart, _MidFieldInnerFadeEnd, distanceFromCamera);
    float outerStart = max(_MidFieldInnerFadeEnd, _MidFieldDrawDistance - _MidFieldOuterFadeBand);
    float outerFade = 1.0 - smoothstep(outerStart, _MidFieldDrawDistance, distanceFromCamera);
    float fadeAlpha = saturate(innerFade * outerFade);
    if (fadeAlpha <= 0.001)
    {
        AddStat(MID_STAT_DISTANCE_FADE_REJECTED);
        return;
    }

    uint slot;
    InterlockedAdd(_MidFieldDrawArgs[1], 1u, slot);
    if (slot >= (uint)_MidFieldCapacity)
    {
        AddStat(MID_STAT_OVERFLOW);
        InterlockedAdd(_MidFieldDrawArgs[1], 0xFFFFFFFFu);
        return;
    }

    float scale = max(_MidFieldPlanetWorldScale, 0.0001);
    float height = max(biome.Shape.y * scale, 0.35);
    height *= lerp(0.82, 1.28, Hash01(cellHash ^ 0x510e527fu));
    float width = max(height * lerp(1.0, 1.45, Hash01(cellHash ^ 0x9b05688cu)),
        _MidFieldSpacing * 1.3);
    float3 upWs = normalize(mul((float3x3)_MidFieldPlanetLocalToWorld, normalLocal));

    GrassCardInstance card;
    card.RootHeight = float4(rootWs + upWs * 0.025, height);
    card.UpWidth = float4(upWs, width);
    card.Color = float4(saturate(biome.Tint.rgb), fadeAlpha);
    _MidFieldGrassInstances[slot] = card;
    AddStat(MID_STAT_EMITTED);
}
