#pragma kernel PlaceAndCullNearField

// Dense camera-centered near-field grass placement, slice 2: face-space stable cells.
// Pairs with [Assets/Scripts/Planet/Grass/GrassNearFieldController.cs].
//
// SLICE 2 CHANGES vs slice 1:
//  - Cells are anchored in stable (face, cellU, cellV) coordinates, NOT camera-relative
//    tangent-plane indices. Same world cell -> same hash -> same blade properties across
//    frames. Camera motion only changes WHICH cells dispatch, not where they live.
//  - Explicit overflow accounting: InterlockedAdd(_NearFieldDrawArgs[1], 1, slot) drives
//    the indirect draw count directly. AppendStructuredBuffer dropped.
//  - Stable per-root distance thinning crossfades near grass into the chunk path. The
//    same world-space root always receives the same keep/reject result at a distance.
//
// Multi-face ranges share one instance buffer. Each range receives a proportional
// emission quota so an expensive primary face cannot starve a narrow neighbor strip.

#include "../Graphics/Shaders/Includes/GrassPlacementCommon.hlsl"

Texture2D<float4> _NearFieldBiomeIds_F0;
Texture2D<float4> _NearFieldBiomeIds_F1;
Texture2D<float4> _NearFieldBiomeIds_F2;
Texture2D<float4> _NearFieldBiomeIds_F3;
Texture2D<float4> _NearFieldBiomeIds_F4;
Texture2D<float4> _NearFieldBiomeIds_F5;
Texture2D<float4> _NearFieldBiomeWeights_F0;
Texture2D<float4> _NearFieldBiomeWeights_F1;
Texture2D<float4> _NearFieldBiomeWeights_F2;
Texture2D<float4> _NearFieldBiomeWeights_F3;
Texture2D<float4> _NearFieldBiomeWeights_F4;
Texture2D<float4> _NearFieldBiomeWeights_F5;
Texture2D<float> _NearFieldSurfaceRadius_F0;
Texture2D<float> _NearFieldSurfaceRadius_F1;
Texture2D<float> _NearFieldSurfaceRadius_F2;
Texture2D<float> _NearFieldSurfaceRadius_F3;
Texture2D<float> _NearFieldSurfaceRadius_F4;
Texture2D<float> _NearFieldSurfaceRadius_F5;
Texture2D<float4> _NearFieldSurfaceNormal_F0;
Texture2D<float4> _NearFieldSurfaceNormal_F1;
Texture2D<float4> _NearFieldSurfaceNormal_F2;
Texture2D<float4> _NearFieldSurfaceNormal_F3;
Texture2D<float4> _NearFieldSurfaceNormal_F4;
Texture2D<float4> _NearFieldSurfaceNormal_F5;
Texture2D<float4> _NearFieldSurfaceState_F0;
Texture2D<float4> _NearFieldSurfaceState_F1;
Texture2D<float4> _NearFieldSurfaceState_F2;
Texture2D<float4> _NearFieldSurfaceState_F3;
Texture2D<float4> _NearFieldSurfaceState_F4;
Texture2D<float4> _NearFieldSurfaceState_F5;
Texture2D<float> _NearFieldPathWear_F0;
Texture2D<float> _NearFieldPathWear_F1;
Texture2D<float> _NearFieldPathWear_F2;
Texture2D<float> _NearFieldPathWear_F3;
Texture2D<float> _NearFieldPathWear_F4;
Texture2D<float> _NearFieldPathWear_F5;

StructuredBuffer<BiomeGrassParams> _NearFieldBiomeGrassParams;
RWStructuredBuffer<GrassBladeInstance> _NearFieldGrassInstances;
RWStructuredBuffer<uint> _NearFieldDrawArgs;
RWStructuredBuffer<uint> _NearFieldStats;
RWStructuredBuffer<uint> _NearFieldRangeCounts;

#define NF_STAT_CANDIDATE_CELLS 0
#define NF_STAT_DENSITY_REJECTED 1
#define NF_STAT_WATER_REJECTED 2
#define NF_STAT_SLOPE_REJECTED 3
#define NF_STAT_DISTANCE_REJECTED 4
#define NF_STAT_DISTANCE_FADE_REJECTED 5
#define NF_STAT_FRUSTUM_REJECTED 6
#define NF_STAT_EMITTED 7
#define NF_STAT_FACE_AREA_REJECTED 8
#define NF_STAT_OVERFLOW 9
#define NF_STAT_RANGE_BUDGET_REJECTED 10

int _NearFieldBiomeAtlasResolution;
int _NearFieldSurfaceAtlasResolution;
int _NearFieldSurfaceStateAtlasResolution;
int _NearFieldPathWearAtlasResolution;
int _NearFieldBiomeParamCount;
int _NearFieldCapacity;
int _NearFieldSeed;
int _NearFieldFaceIndex;
int _NearFieldRangeIndex;
int _NearFieldRangeBudget;
int2 _NearFieldGridStartCellUV;
int2 _NearFieldGridSize;
float _NearFieldCellUvWidth;
float _NearFieldSpacing;            // for hash variation and width/height world scale
float _NearFieldFullDensityDistance;
float _NearFieldDrawDistance;
float _NearFieldFadeBand;
float _NearFieldWaterRadius;
float _NearFieldPlanetRadius;
float _NearFieldPlanetWorldScale;
float4x4 _NearFieldPlanetLocalToWorld;
float3 _NearFieldPlanetCenterWs;
float3 _NearFieldCameraPositionWs;
Texture2DArray _ClimateMap;
int _ClimateMapResolution;

#define GRASS_PLACEMENT_PARAM_BUFFER _NearFieldBiomeGrassParams
#define GRASS_PLACEMENT_PARAM_COUNT _NearFieldBiomeParamCount
#include "../Graphics/Shaders/Includes/GrassPlacementParamBlend.hlsl"
#undef GRASS_PLACEMENT_PARAM_COUNT
#undef GRASS_PLACEMENT_PARAM_BUFFER

void AddStat(uint index, uint value)
{
    InterlockedAdd(_NearFieldStats[index], value);
}

float CubeFaceAreaKeep(float2 uv)
{
    // Fixed-size face-UV cells cover less world-space area near cube-face edges.
    // Keep probability matches the cube-to-sphere area ratio relative to face center.
    float2 signedUv = uv * 2.0 - 1.0;
    float denom = max(1.0 + dot(signedUv, signedUv), 1e-6);
    return saturate(rsqrt(denom * denom * denom));
}

float4 LoadBiomeIdsTexel(int face, int2 ip)
{
    float4 ids = 0.0;
    if (face == 0) ids = _NearFieldBiomeIds_F0.Load(int3(ip, 0));
    else if (face == 1) ids = _NearFieldBiomeIds_F1.Load(int3(ip, 0));
    else if (face == 2) ids = _NearFieldBiomeIds_F2.Load(int3(ip, 0));
    else if (face == 3) ids = _NearFieldBiomeIds_F3.Load(int3(ip, 0));
    else if (face == 4) ids = _NearFieldBiomeIds_F4.Load(int3(ip, 0));
    else ids = _NearFieldBiomeIds_F5.Load(int3(ip, 0));
    return ids;
}

float4 LoadBiomeWeightsTexel(int face, int2 ip)
{
    float4 weights = 0.0;
    if (face == 0) weights = _NearFieldBiomeWeights_F0.Load(int3(ip, 0));
    else if (face == 1) weights = _NearFieldBiomeWeights_F1.Load(int3(ip, 0));
    else if (face == 2) weights = _NearFieldBiomeWeights_F2.Load(int3(ip, 0));
    else if (face == 3) weights = _NearFieldBiomeWeights_F3.Load(int3(ip, 0));
    else if (face == 4) weights = _NearFieldBiomeWeights_F4.Load(int3(ip, 0));
    else weights = _NearFieldBiomeWeights_F5.Load(int3(ip, 0));
    return weights;
}

float SampleSurfaceRadius(int face, float2 uv)
{
    int resolution = max(_NearFieldSurfaceAtlasResolution, 1);
    float2 p = saturate(uv) * max(resolution - 1, 1);
    int2 p0 = clamp(int2(floor(p)), int2(0, 0), int2(resolution - 1, resolution - 1));
    int2 p1 = min(p0 + 1, int2(resolution - 1, resolution - 1));
    float2 f = p - p0;
    float r00, r10, r01, r11;
    if (face == 0)
    {
        r00 = _NearFieldSurfaceRadius_F0.Load(int3(p0, 0));
        r10 = _NearFieldSurfaceRadius_F0.Load(int3(p1.x, p0.y, 0));
        r01 = _NearFieldSurfaceRadius_F0.Load(int3(p0.x, p1.y, 0));
        r11 = _NearFieldSurfaceRadius_F0.Load(int3(p1, 0));
    }
    else if (face == 1)
    {
        r00 = _NearFieldSurfaceRadius_F1.Load(int3(p0, 0));
        r10 = _NearFieldSurfaceRadius_F1.Load(int3(p1.x, p0.y, 0));
        r01 = _NearFieldSurfaceRadius_F1.Load(int3(p0.x, p1.y, 0));
        r11 = _NearFieldSurfaceRadius_F1.Load(int3(p1, 0));
    }
    else if (face == 2)
    {
        r00 = _NearFieldSurfaceRadius_F2.Load(int3(p0, 0));
        r10 = _NearFieldSurfaceRadius_F2.Load(int3(p1.x, p0.y, 0));
        r01 = _NearFieldSurfaceRadius_F2.Load(int3(p0.x, p1.y, 0));
        r11 = _NearFieldSurfaceRadius_F2.Load(int3(p1, 0));
    }
    else if (face == 3)
    {
        r00 = _NearFieldSurfaceRadius_F3.Load(int3(p0, 0));
        r10 = _NearFieldSurfaceRadius_F3.Load(int3(p1.x, p0.y, 0));
        r01 = _NearFieldSurfaceRadius_F3.Load(int3(p0.x, p1.y, 0));
        r11 = _NearFieldSurfaceRadius_F3.Load(int3(p1, 0));
    }
    else if (face == 4)
    {
        r00 = _NearFieldSurfaceRadius_F4.Load(int3(p0, 0));
        r10 = _NearFieldSurfaceRadius_F4.Load(int3(p1.x, p0.y, 0));
        r01 = _NearFieldSurfaceRadius_F4.Load(int3(p0.x, p1.y, 0));
        r11 = _NearFieldSurfaceRadius_F4.Load(int3(p1, 0));
    }
    else
    {
        r00 = _NearFieldSurfaceRadius_F5.Load(int3(p0, 0));
        r10 = _NearFieldSurfaceRadius_F5.Load(int3(p1.x, p0.y, 0));
        r01 = _NearFieldSurfaceRadius_F5.Load(int3(p0.x, p1.y, 0));
        r11 = _NearFieldSurfaceRadius_F5.Load(int3(p1, 0));
    }
    return lerp(lerp(r00, r10, f.x), lerp(r01, r11, f.x), f.y);
}

float3 SampleSurfaceNormal(int face, float2 uv)
{
    int resolution = max(_NearFieldSurfaceAtlasResolution, 1);
    float2 p = saturate(uv) * max(resolution - 1, 1);
    int2 ip = clamp(int2(round(p)), int2(0, 0), int2(resolution - 1, resolution - 1));
    float4 packed;
    if (face == 0) packed = _NearFieldSurfaceNormal_F0.Load(int3(ip, 0));
    else if (face == 1) packed = _NearFieldSurfaceNormal_F1.Load(int3(ip, 0));
    else if (face == 2) packed = _NearFieldSurfaceNormal_F2.Load(int3(ip, 0));
    else if (face == 3) packed = _NearFieldSurfaceNormal_F3.Load(int3(ip, 0));
    else if (face == 4) packed = _NearFieldSurfaceNormal_F4.Load(int3(ip, 0));
    else packed = _NearFieldSurfaceNormal_F5.Load(int3(ip, 0));
    return normalize(packed.xyz * 2.0 - 1.0);
}

float4 LoadSurfaceStateTexel(int face, int2 ip)
{
    float4 state = 0.0;
    if (face == 0) state = _NearFieldSurfaceState_F0.Load(int3(ip, 0));
    else if (face == 1) state = _NearFieldSurfaceState_F1.Load(int3(ip, 0));
    else if (face == 2) state = _NearFieldSurfaceState_F2.Load(int3(ip, 0));
    else if (face == 3) state = _NearFieldSurfaceState_F3.Load(int3(ip, 0));
    else if (face == 4) state = _NearFieldSurfaceState_F4.Load(int3(ip, 0));
    else state = _NearFieldSurfaceState_F5.Load(int3(ip, 0));
    return state;
}

float4 SampleSurfaceState(int face, float2 uv)
{
    int maxTexel = max(_NearFieldSurfaceStateAtlasResolution - 1, 0);
    float2 p = saturate(uv) * max(maxTexel, 1);
    int2 p0 = clamp(int2(floor(p)), int2(0, 0), int2(maxTexel, maxTexel));
    int2 p1 = min(p0 + 1, int2(maxTexel, maxTexel));
    float2 f = saturate(p - p0);
    float4 c00 = LoadSurfaceStateTexel(face, p0);
    float4 c10 = LoadSurfaceStateTexel(face, int2(p1.x, p0.y));
    float4 c01 = LoadSurfaceStateTexel(face, int2(p0.x, p1.y));
    float4 c11 = LoadSurfaceStateTexel(face, p1);
    return lerp(lerp(c00, c10, f.x), lerp(c01, c11, f.x), f.y);
}

float LoadPathWearTexel(int face, int2 ip)
{
    if (face == 0) return _NearFieldPathWear_F0.Load(int3(ip, 0));
    if (face == 1) return _NearFieldPathWear_F1.Load(int3(ip, 0));
    if (face == 2) return _NearFieldPathWear_F2.Load(int3(ip, 0));
    if (face == 3) return _NearFieldPathWear_F3.Load(int3(ip, 0));
    if (face == 4) return _NearFieldPathWear_F4.Load(int3(ip, 0));
    return _NearFieldPathWear_F5.Load(int3(ip, 0));
}

float SamplePathWear(int face, float2 uv)
{
    int maxTexel = max(_NearFieldPathWearAtlasResolution - 1, 0);
    float2 p = saturate(uv) * max(maxTexel, 1);
    int2 p0 = clamp(int2(floor(p)), int2(0, 0), int2(maxTexel, maxTexel));
    int2 p1 = min(p0 + 1, int2(maxTexel, maxTexel));
    float2 f = saturate(p - p0);
    float c00 = LoadPathWearTexel(face, p0);
    float c10 = LoadPathWearTexel(face, int2(p1.x, p0.y));
    float c01 = LoadPathWearTexel(face, int2(p0.x, p1.y));
    float c11 = LoadPathWearTexel(face, p1);
    return saturate(lerp(lerp(c00, c10, f.x), lerp(c01, c11, f.x), f.y));
}

float SamplePathMask(int face, float2 uv)
{
    float surfaceReject = SurfaceStateReject(SampleSurfaceState(face, uv));
    return saturate(max(surfaceReject, SamplePathWear(face, uv)));
}

BiomeGrassParams SampleGrassParamsBilinear(int face, float2 uv, out float density)
{
    // Match the terrain shader's manual 4-corner biome blend. The ids texture is
    // categorical, so sampling one rounded texel still snaps grass color/shape at texel
    // boundaries even when each texel's top-K weights are blended.
    int2 t00, t10, t01, t11;
    float2 f;
    GrassPlacementBilinearTexels(uv, _NearFieldBiomeAtlasResolution, t00, t10, t01, t11, f);

    return BlendGrassParamCorners(
        LoadBiomeIdsTexel(face, t00), LoadBiomeWeightsTexel(face, t00),
        LoadBiomeIdsTexel(face, t10), LoadBiomeWeightsTexel(face, t10),
        LoadBiomeIdsTexel(face, t01), LoadBiomeWeightsTexel(face, t01),
        LoadBiomeIdsTexel(face, t11), LoadBiomeWeightsTexel(face, t11),
        f,
        density);
}

[numthreads(8, 8, 1)]
void PlaceAndCullNearField(uint3 id : SV_DispatchThreadID)
{
    if ((int)id.x >= _NearFieldGridSize.x || (int)id.y >= _NearFieldGridSize.y)
        return;

    AddStat(NF_STAT_CANDIDATE_CELLS, 1u);

    // Stable face-space cell. Hash binds (face, cellU, cellV) to a deterministic seed,
    // so the same world position yields the same blade properties across frames. THIS is
    // what makes the grass attached to the planet instead of swimming with the camera.
    int2 cellIndex = _NearFieldGridStartCellUV + int2(id.xy);
    uint cellHash = HashUint((uint)_NearFieldSeed
        ^ ((uint)_NearFieldFaceIndex * 0x9e3779b9u)
        ^ ((uint)cellIndex.x * 73856093u)
        ^ ((uint)cellIndex.y * 19349663u));

    // Sub-cell jitter using the stable cell hash so the position inside each face cell
    // is also stable across frames.
    float2 jitter = float2(Hash01(cellHash ^ 0xa341316cu) - 0.5,
                           Hash01(cellHash ^ 0x6a09e667u) - 0.5);
    float2 faceUv = (float2(cellIndex) + 0.5 + jitter) * _NearFieldCellUvWidth;
    if (faceUv.x < 0.0 || faceUv.x > 1.0 || faceUv.y < 0.0 || faceUv.y > 1.0)
    {
        // Cell projects outside the face UV square - drop. Seam handling is the
        // controller's job (deferred to slice 3).
        AddStat(NF_STAT_FACE_AREA_REJECTED, 1u);
        return;
    }

    float areaKeep = CubeFaceAreaKeep(faceUv);
    if (Hash01(cellHash ^ 0x2c1b3c6du) > areaKeep)
    {
        AddStat(NF_STAT_FACE_AREA_REJECTED, 1u);
        return;
    }

    // Path mask thins grass probabilistically per cell (density drops toward the path) and
    // survivors are shortened below (height *= grassScale). Stochastic rejection dithers the
    // boundary so it follows the worn coverage, not the placement grid.
    float grassScale = saturate(1.0 - SamplePathMask(_NearFieldFaceIndex, faceUv));
    if (Hash01(cellHash ^ 0x2545f491u) > grassScale)
    {
        AddStat(NF_STAT_DENSITY_REJECTED, 1u);
        return;
    }

    float3 dirWs = CubeFaceToUnitSphere(_NearFieldFaceIndex, faceUv);

    // Sample surface radius to get the exact root position on the sphere.
    float surfaceRadius = SampleSurfaceRadius(_NearFieldFaceIndex, faceUv);
    float3 localRoot = dirWs * surfaceRadius;
    float3 rootWs = mul(_NearFieldPlanetLocalToWorld, float4(localRoot, 1.0)).xyz;

    // Distance gate + smooth stochastic thinning. Fade all the way to zero before the
    // draw boundary so the camera-centered near path cannot end as a visible circle.
    float distanceFromCamera = length(rootWs - _NearFieldCameraPositionWs);
    if (distanceFromCamera > _NearFieldDrawDistance)
    {
        AddStat(NF_STAT_DISTANCE_REJECTED, 1u);
        return;
    }
    float fadeStart = max(
        _NearFieldFullDensityDistance,
        _NearFieldDrawDistance - max(_NearFieldFadeBand, 0.0));
    float distanceThinT = saturate((distanceFromCamera - fadeStart)
        / max(_NearFieldDrawDistance - fadeStart, 0.001));
    float distanceKeep = 1.0 - smoothstep(0.0, 1.0, distanceThinT);
    if (Hash01(cellHash ^ 0x1f83d9abu) > distanceKeep)
    {
        AddStat(NF_STAT_DISTANCE_FADE_REJECTED, 1u);
        return;
    }

    // Biome density gate.
    float density;
    BiomeGrassParams biome = SampleGrassParamsBilinear(_NearFieldFaceIndex, faceUv, density);
    if (density <= 0.001)
    {
        AddStat(NF_STAT_DENSITY_REJECTED, 1u);
        return;
    }
    if (biome.Shape.y <= 0.0 || biome.Shape.z <= 0.0)
    {
        AddStat(NF_STAT_DENSITY_REJECTED, 1u);
        return;
    }

    // Water clearance.
    if (_NearFieldWaterRadius > 0.0
        && surfaceRadius <= _NearFieldWaterRadius + max(biome.Placement.z, 0.0))
    {
        AddStat(NF_STAT_WATER_REJECTED, 1u);
        return;
    }

    // Slope.
    float3 normalLocal = SampleSurfaceNormal(_NearFieldFaceIndex, faceUv);
    if (dot(normalLocal, dirWs) < 0.0)
        normalLocal = -normalLocal;
    float slopeDeg = acos(saturate(dot(normalLocal, dirWs))) * 57.2957795;
    float maxSlope = saturate(biome.Placement.x / 90.0) * 90.0;
    float fade = max(biome.Placement.y, 0.001);
    float slopeKeep = 1.0 - smoothstep(maxSlope - fade, maxSlope + fade, slopeDeg);
    if (Hash01(cellHash ^ 0xa54ff53au) > slopeKeep)
    {
        AddStat(NF_STAT_SLOPE_REJECTED, 1u);
        return;
    }

    // Per-blade density roll (partial-density biomes thin probabilistically).
    if (Hash01(cellHash ^ 0x3c6ef372u) > density)
    {
        AddStat(NF_STAT_DENSITY_REJECTED, 1u);
        return;
    }

    // Reserve a proportional part of the shared output buffer for each active face.
    // This keeps a large primary-face dispatch from consuming every slot before a
    // narrow seam-neighbor range runs.
    uint rangeSlot;
    InterlockedAdd(_NearFieldRangeCounts[_NearFieldRangeIndex], 1u, rangeSlot);
    if (rangeSlot >= (uint)max(_NearFieldRangeBudget, 0))
    {
        AddStat(NF_STAT_RANGE_BUDGET_REJECTED, 1u);
        return;
    }

    // Explicit slot allocation drives the indirect draw count directly. No CopyCount.
    uint slot;
    InterlockedAdd(_NearFieldDrawArgs[1], 1u, slot);
    if (slot >= (uint)_NearFieldCapacity)
    {
        AddStat(NF_STAT_OVERFLOW, 1u);
        // Roll back so the indirect args count stays accurate (capacity-clamped).
        InterlockedAdd(_NearFieldDrawArgs[1], 0xFFFFFFFFu);
        return;
    }

    float3 upWs = normalize(mul((float3x3)_NearFieldPlanetLocalToWorld, normalLocal));

    float heightVariation = lerp(0.75, 1.25, Hash01(cellHash ^ 0x510e527fu));
    float widthVariation = lerp(0.80, 1.15, Hash01(cellHash ^ 0x9b05688cu));
    float height = biome.Shape.y * max(_NearFieldPlanetWorldScale, 0.0001) * heightVariation * grassScale;
    float width = biome.Shape.z * max(_NearFieldPlanetWorldScale, 0.0001) * widthVariation * grassScale;

    float moisture = SampleClimateMoisture(_NearFieldFaceIndex, faceUv);
    float3 shift = lerp(biome.TintDry.rgb, biome.TintLush.rgb, moisture);
    GrassBladeInstance blade;
    blade.RootHeight = float4(rootWs, height);
    blade.UpWidth = float4(upWs, width);
    blade.Color = float4(saturate(biome.Tint.rgb * shift), 1.0);
    _NearFieldGrassInstances[slot] = blade;
    AddStat(NF_STAT_EMITTED, 1u);
}
