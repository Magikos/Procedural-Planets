// Bakes sun-ray optical depth into a 2D LUT.
// U = dot(normal, rayDir) remapped to [0,1]. V = height01 in atmosphere.
// Output: float2(rayleighOD, mieOD) packed into RG channels.

#pragma kernel Main
#include "Includes/Math.hlsl"

RWTexture2D<float4> _Result;

int _TextureSize;
int _NumSteps;

float _PlanetRadius;
float _AtmosphereRadius;
float _RayleighScaleHeight;
float _MieScaleHeight;

[numthreads(8, 8, 1)]
void Main(uint2 id : SV_DispatchThreadID)
{
    float2 uv = (id + 0.5) / (float)_TextureSize;
    float height01 = uv.y;

    // Reconstruct ray direction from angle encoding
    // uvX=0 means ray pointing straight up (dot=1), uvX=1 means straight down (dot=-1)
    float cosAngle = 1.0 - 2.0 * uv.x;
    float sinAngle = sqrt(max(0, 1.0 - cosAngle * cosAngle));
    float2 dir = float2(sinAngle, cosAngle);

    // Start point at this height in the atmosphere
    float startHeight = lerp(_PlanetRadius, _AtmosphereRadius, height01);
    float2 inPoint = float2(0, startHeight);

    // How far does this ray travel through the atmosphere?
    float dstThrough = RaySphere(0, _AtmosphereRadius, float3(inPoint, 0), float3(dir, 0)).y;
    if (dstThrough <= 0)
    {
        _Result[id.xy] = 0;
        return;
    }

    float stepSize = dstThrough / (float)_NumSteps;
    float2 samplePos = inPoint + dir * (stepSize * 0.5);

    float rayleighOD = 0;
    float mieOD = 0;

    for (int i = 0; i < _NumSteps; i++)
    {
        float height = length(samplePos) - _PlanetRadius;

        // If ray goes below planet surface, return large value (blocked)
        if (height < 0)
        {
            _Result[id.xy] = float4(1e6, 1e6, 0, 0);
            return;
        }

        rayleighOD += exp(-height / _RayleighScaleHeight) * stepSize;
        mieOD += exp(-height / _MieScaleHeight) * stepSize;

        samplePos += dir * stepSize;
    }

    _Result[id.xy] = float4(rayleighOD, mieOD, 0, 0);
}
